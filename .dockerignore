# Dependencies: reinstalled inside the build stage. A host or CI-restored
# node_modules copied over pnpm's tree makes pnpm stop before `pnpm build`.
node_modules

# VCS history, never needed at runtime. .gitignore stays: Tailwind reads it to
# decide which files to scan for class names.
.git

# Build outputs: regenerated by `pnpm build` inside the image
build
.react-router

# Tests, fixtures and E2E assets: not part of the runtime image
cypress
cypress.config.ts
tests
coverage
.nyc_output

# Local env / secrets
.env
.env.*

# Deployment manifests and local dev setup
config
dev
docker-compose.yml

# Docs, meta and agent memory
docs
*.md
LICENSE
.dmx
.claude

# CI / tooling config not needed at runtime
.github
.vscode
.cursor

# Caches and logs
.cache
*.log
