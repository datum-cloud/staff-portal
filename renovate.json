{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>datum-cloud/.github:renovate-config"],
  "constraints": {
    "npm": "<12"
  },
  "packageRules": [
    {
      "description": "Pin Vite to v7: React Router and Cypress component testing do not yet support Vite 8",
      "matchPackageNames": ["vite"],
      "allowedVersions": "<8"
    }
  ]
}
