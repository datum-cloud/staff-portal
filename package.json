{
  "name": "staff-portal",
  "version": "0.0.1",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && vite build --config vite.observability.config.ts",
    "dev": "node --env-file-if-exists=.env --import tsx ./observability/dev-start.js",
    "start": "node --env-file-if-exists=.env ./observability/start.js",
    "lint": "eslint \"{app,lib}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" \"!**/locales/**\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" \"!**/locales/**\"",
    "typecheck": "react-router typegen && tsc",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:unit": "cypress open --component",
    "test:unit:prod": "cypress run --component --config-file cypress.config.ts --quiet",
    "test:unit:debug": "cypress open --component",
    "test:e2e": "start-server-and-test 'npm run dev' http://localhost:3000/_healthz 'cypress run'",
    "test:e2e:prod": "start-server-and-test 'npm run start' http://localhost:3000/_healthz 'cypress run --config-file cypress.config.ts --quiet'",
    "test:e2e:debug": "start-server-and-test 'npm run start' http://localhost:3000/_healthz 'cypress open'",
    "openapi:list": "node scripts/openapi-list.ts",
    "openapi:generate": "node scripts/openapi.ts",
    "graphql": "node scripts/graphql.ts",
    "test": "vitest run"
  },
